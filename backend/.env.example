# Copy to .env and adjust. Sensible defaults let the app run with zero infra.
ENVIRONMENT=development
DEBUG=true

# SQLite by default; Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./sentinel.db
# DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@db:5432/sentinel

SECRET_KEY=change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM: groq (real API) | mock (deterministic and offline)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional infra (graceful fallback if unset)
REDIS_URL=redis://redis:6379/0
# CHROMA_HOST=chroma
CHROMA_PORT=8001

STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=120
