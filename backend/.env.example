# Copy to .env and adjust. Sensible defaults let the app run with zero infra.
ENVIRONMENT=development
DEBUG=true

# SQLite by default; Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite:///./sentinel.db
# DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@db:5432/sentinel

SECRET_KEY=change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM: mock (default, offline) | openai | azure | ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Optional infra (graceful fallback if unset)
REDIS_URL=redis://redis:6379/0
# CHROMA_HOST=chroma
CHROMA_PORT=8001

STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=120
