# Root environment example for Docker Compose.
# Backend reads its own backend/.env in local (non-Docker) runs.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

SECRET_KEY=change-me-in-production-please-32bytes-min

# Groq powers language-only agent tasks. Leave the key empty to use MockLLM.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
